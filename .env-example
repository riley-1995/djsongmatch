# Optional overrides for local Docker and deployment.
# Docker Compose now defaults to an internal Postgres service, so a .env file is no longer
# required for local startup unless you want to override these values.

DATABASE_URL=postgresql://djsongmatch:djsongmatch@db:5432/djsongmatch
POSTGRES_USER=djsongmatch
POSTGRES_PASSWORD=djsongmatch
POSTGRES_DB=djsongmatch
NEXT_PUBLIC_API_URL=http://backend:5001
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
